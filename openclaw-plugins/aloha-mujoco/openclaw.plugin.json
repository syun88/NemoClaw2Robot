{
  "id": "aloha-mujoco",
  "activation": {
    "onStartup": true
  },
  "enabledByDefault": true,
  "name": "ALOHA MuJoCo Robot Tools",
  "description": "OpenClaw tools that run NemoClaw2Robot ALOHA MuJoCo prompt tasks from the sandbox, including queued live-viewer requests.",
  "contracts": {
    "tools": [
      "aloha_mujoco_plan",
      "aloha_mujoco_run",
      "aloha_mujoco_live",
      "aloha_prompt_control",
      "aloha_session_start",
      "aloha_get_state",
      "aloha_solve_ik",
      "aloha_move_relative",
      "aloha_move_to_pose",
      "aloha_execute_cartesian_path",
      "aloha_set_gripper",
      "aloha_add_object",
      "aloha_add_trace",
      "aloha_check_pose",
      "aloha_check_contacts"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projectRoot": {
        "type": "string",
        "default": "/sandbox/NemoClaw2Robot",
        "description": "Path to the NemoClaw2Robot runtime inside the OpenClaw sandbox."
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "default": 180000,
        "description": "Default timeout for ALOHA MuJoCo commands."
      },
      "liveViewerUrl": {
        "type": "string",
        "default": "http://host.docker.internal:8765",
        "description": "Optional host-side live MuJoCo viewer bridge URL used when delivery is http."
      }
    }
  }
}
